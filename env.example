# Database — from Vercel Postgres (or Neon/Supabase) dashboard after you create the DB
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Email provider for magic-link sign-in (NextAuth Email provider)
# Any SMTP provider works — Resend, Postmark, or a Gmail app password for testing
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="cbt-practice@keele.ac.uk"

# Anthropic API key — from console.anthropic.com. Server-side only, never expose to the client.
ANTHROPIC_API_KEY=""

# Comma-separated list of instructor emails — used to auto-assign the INSTRUCTOR role on first sign-in
INSTRUCTOR_EMAILS="p.dhandapani@keele.ac.uk"
